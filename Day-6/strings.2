# ============================================================
# PYTHON STRING FUNCTIONS & METHODS
# ============================================================

# ============================================================
# 1. len()
# ============================================================
# Definition:
# len() returns the total number of characters in a string.
# Spaces are also counted.

c = " python programing"

print(len(c))

# Output:
# 18


# ============================================================
# 2. ord()
# ============================================================
# Definition:
# ord() returns the ASCII/Unicode value of a character.

print(ord("p"))

# Output:
# 112

print(ord("a"))

# Output:
# 97


# ============================================================
# 3. chr()
# ============================================================
# Definition:
# chr() converts an ASCII/Unicode value into a character.

print(chr(65))

# Output:
# 'A'

print(chr(66))

# Output:
# 'B'


# ============================================================
# 4. min() and max()
# ============================================================
# Definition:
# min() returns the smallest character.
# max() returns the largest character.

print(min(c))

# Output:
# ' '
# (Space is the smallest character.)

print(max(c))

# Output:
# 'y'


# ============================================================
# 5. sorted()
# ============================================================
# Definition:
# sorted() returns all characters in sorted order.
# It returns a LIST (not a tuple).

print(sorted(c))

# Output:
# [' ', ' ', 'a', 'g', 'g', 'h', 'i', 'm', 'n',
#  'n', 'o', 'o', 'p', 'p', 'r', 'r', 't', 'y']


